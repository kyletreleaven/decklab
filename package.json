    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "hono": "^4.13.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
