{
  "name": "decklab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "SCRYFALL_CONTRACT=1 vitest run --testTimeout=60000 src/lib/scryfall.contract.test.ts",
    "tauri": "tauri",
    "lab": "DECKLAB_LAB=1 tauri dev",
    "test:sql": "QUERY_SQL=1 vitest run src/lib/query/compile.integration.test.ts",
    "test:library": "LIBRARY_DB=1 vitest run --testTimeout=120000 src/lib/library/v4db.integration.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
